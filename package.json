{
  "name": "finops-tools",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Vladimir Miasnikov"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
