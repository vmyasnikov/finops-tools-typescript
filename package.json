    "format:check": "oxfmt --check .",
    "cli": "pnpm --filter @finops-tools/cli run dev"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4"
}
